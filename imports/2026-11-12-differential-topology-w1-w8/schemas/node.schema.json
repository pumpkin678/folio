{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Folio Knowledge Node 1.0",
  "type": "object",
  "required": ["id", "title", "subject", "kind", "links", "sources", "review_status"],
  "properties": {
    "id": {"type":"string", "pattern":"^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"},
    "title": {"type":"string", "minLength":1},
    "subject": {"type":"string", "pattern":"^[a-z][a-z0-9-]*$"},
    "kind": {"enum":["definition","theorem","example","exercise","solution","counterexample","note"]},
    "tags": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "links": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "sources": {"type":"array","items":{"type":"object","required":["type","reference"],"properties":{"type":{"type":"string"},"reference":{"type":"string"},"verified":{"type":"boolean"}}}},
    "review_status": {"enum":["draft","reviewed","verified"]}
  },
  "additionalProperties":false
}
