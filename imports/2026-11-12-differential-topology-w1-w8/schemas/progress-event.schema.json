{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Folio Progress Event 1.0 (client payload)",
  "type": "object",
  "required": ["event_id", "node_id", "device_id", "event_type", "value"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "node_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"},
    "device_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["status_set", "reset", "reviewed", "favorite_set"]},
    "value": {},
    "client_created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
